# Test environment
BASE_URL=

# Swagger / OpenAPI document (JSON), used by `npm run types:api`
OPENAPI_SOURCE=

# Web app address for browser tests (same host as BASE_URL for BugBoard)
WEB_URL=

# Not needed for BugBoard: the admin account is registered by the tests themselves
# (see tests/_setup/auth.setup.ts). Fill these only to log in with an account you already have.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
