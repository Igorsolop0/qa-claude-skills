{
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Stable machine-readable code, for example NOT_FOUND"
          },
          "message": {
            "type": "string"
          },
          "details": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "path",
                "message"
              ],
              "properties": {
                "path": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "User": {
        "type": "object",
        "required": [
          "id",
          "email",
          "name",
          "role",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "admin",
              "tester"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "AuthResponse": {
        "type": "object",
        "required": [
          "token",
          "user"
        ],
        "properties": {
          "token": {
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/User"
          }
        }
      },
      "Project": {
        "type": "object",
        "required": [
          "id",
          "key",
          "name",
          "description",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "key": {
            "type": "string",
            "pattern": "^[A-Z]{2,6}$"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Ticket": {
        "type": "object",
        "required": [
          "id",
          "projectId",
          "title",
          "description",
          "status",
          "priority",
          "reporterId",
          "assigneeId",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "projectId": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "in_progress",
              "resolved",
              "closed"
            ]
          },
          "priority": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "reporterId": {
            "type": "integer",
            "minimum": 1,
            "nullable": true
          },
          "assigneeId": {
            "type": "integer",
            "minimum": 1,
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "TicketList": {
        "type": "object",
        "required": [
          "items",
          "total",
          "limit",
          "offset"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Ticket"
            }
          },
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "limit": {
            "type": "integer"
          },
          "offset": {
            "type": "integer"
          }
        }
      },
      "Comment": {
        "type": "object",
        "required": [
          "id",
          "ticketId",
          "authorId",
          "body",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "ticketId": {
            "type": "integer",
            "minimum": 1
          },
          "authorId": {
            "type": "integer",
            "minimum": 1,
            "nullable": true
          },
          "body": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Report": {
        "type": "object",
        "required": [
          "id",
          "status",
          "projectId",
          "createdAt",
          "result"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "done"
            ]
          },
          "projectId": {
            "type": "integer",
            "minimum": 1,
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "result": {
            "type": "object",
            "nullable": true,
            "required": [
              "total",
              "byStatus"
            ],
            "properties": {
              "total": {
                "type": "integer"
              },
              "byStatus": {
                "type": "object",
                "required": [
                  "open",
                  "in_progress",
                  "resolved",
                  "closed"
                ],
                "properties": {
                  "open": {
                    "type": "integer"
                  },
                  "in_progress": {
                    "type": "integer"
                  },
                  "resolved": {
                    "type": "integer"
                  },
                  "closed": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
